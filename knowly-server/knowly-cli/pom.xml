<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.knowly</groupId>
        <artifactId>knowly-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>knowly-cli</artifactId>
    <name>knowly-cli</name>
    <description>CLI 入口：main 类、命令分发、调 PipelineEngine 跑清洗</description>

    <dependencies>
        <!-- 所有实现层依赖（CLI 需要组装完整流水线） -->
        <dependency>
            <groupId>com.knowly</groupId>
            <artifactId>knowly-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.knowly</groupId>
            <artifactId>knowly-ingest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowly</groupId>
            <artifactId>knowly-clean</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowly</groupId>
            <artifactId>knowly-embed</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.knowly</groupId>
            <artifactId>knowly-graph</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- YAML 配置解析 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- 日志实现 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打成可执行 fat jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.sf</exclude>
                                        <exclude>META-INF/*.dsa</exclude>
                                        <exclude>META-INF/*.rsa</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.knowly.cli.KnowlyMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
